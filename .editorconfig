# .editorconfig - Global configuration for the "rtunk" repository
# https://editorconfig.org

root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Markdown and text files
[*.{md,markdown,txt}]
trim_trailing_whitespace = false
max_line_length = 120

[README.md]
trim_trailing_whitespace = false

# YAML files (indentation sensitive)
[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# JSON files
[*.json]
indent_style = space
indent_size = 2
insert_final_newline = false

# JavaScript / TypeScript
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# Go files (gofmt uses tabs)
[*.go]
indent_style = tab

# Makefiles (require tabs for recipes)
[Makefile]
indent_style = tab
trim_trailing_whitespace = false

# Configuration files
[*.{toml,ini,conf,cnf}]
indent_style = space
indent_size = 2

# Binary and image files
[*.{png,jpg,jpeg,gif,webp,ico,zip,tar.gz,exe,dll,lock,sqlite}]
trim_trailing_whitespace = false
insert_final_newline = false
